# Example only; replace the addresses and ASNs before use.
# Matches examples/config.example.json.
neighbor 192.168.10.1 {
    description "UniFi route optimizer";
    router-id 192.168.10.50;
    local-address 192.168.10.50;
    local-as 65050;
    peer-as 65050;
    hold-time 30;
    family {
        ipv4 unicast;
    }
}