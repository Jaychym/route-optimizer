[Unit]
Description=Route Optimizer v3.3 - dual-WAN BGP optimizer
Wants=network-online.target nfdump@default.service exabgp.service
After=network-online.target nfdump@default.service exabgp.service
RequiresMountsFor=/var/cache/nfdump /var/lib/route-optimizer
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/route-optimizer
Environment=PYTHONUNBUFFERED=1
# DRY RUN by default. Add --apply only after reviewing output and UCG BGP limits.
ExecStart=/usr/bin/python3 -u /opt/route-optimizer/route-optimizer.py --watch 60 --top 50 --max-routes 50
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target