[Unit]
Description=Route Optimizer v3.4 - rustbgpd dual-WAN optimizer (DRY-RUN)
Wants=network-online.target nfdump@default.service rustbgpd.service
After=network-online.target nfdump@default.service rustbgpd.service
RequiresMountsFor=/var/cache/nfdump /var/lib/route-optimizer
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/route-optimizer
Environment=PYTHONUNBUFFERED=1
# Safe default: no --apply; never enable changes without explicit review.
ExecStart=/usr/bin/python3 -u /opt/route-optimizer/route-optimizer.py --config /etc/route-optimizer/config.json --watch 60 --top 50 --max-routes 50
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
